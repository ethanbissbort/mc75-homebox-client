#include <windows.h>
#include <commctrl.h>
#include <aygshell.h>
#include "resource.h"

// Application icon
IDI_APPICON ICON "icons/app.ico"

// Popup menu presented from the Windows Mobile soft-key menu bar.
IDM_MAINMENU MENU
BEGIN
    POPUP "&Menu"
    BEGIN
        MENUITEM "&Scan",           IDM_VIEW_SCAN
        MENUITEM "&Item",           IDM_VIEW_ITEM
        MENUITEM "Set &location",   IDM_ACTION_SETLOC
        MENUITEM "&Queue",          IDM_VIEW_QUEUE
        MENUITEM "S&ync now",       IDM_ACTION_SYNC
        MENUITEM SEPARATOR
        MENUITEM "&About",          IDM_HELP_ABOUT
        MENUITEM "E&xit",           IDM_FILE_EXIT
    END
END

// Windows Mobile soft-key menu bar (created at runtime with SHCreateMenuBar).
// The first field is the resource ID of the MENU that supplies the popups -
// SHCreateMenuBar LoadMenu()s it - and the trailing 0 of the button record is
// the index of the popup to drop down. Naming the menu bar's own ID there
// makes LoadMenu fail and the whole bar never appears.
IDR_MENUBAR SHMENUBAR MOVEABLE PURE
BEGIN
    IDM_MAINMENU, 1,
    I_IMAGENONE, IDM_MAINMENU, TBSTATE_ENABLED,
        TBSTYLE_DROPDOWN | TBSTYLE_AUTOSIZE, IDS_MENU, 0, 0
END
